# Copy this into Coolify's environment variables for the app (not into the
# repo/image — .env* is git/docker-ignored and injected at runtime instead).

# Prisma's own tables (users/accounts/sessions/otps/flashcard_sets/etc) —
# now Postgres, not SQLite. No persistent volume needed anymore (the old
# SQLite-in-a-volume requirement is gone): `prisma migrate deploy` runs on
# every container start and is a no-op once the schema is applied. This can
# point at the SAME NEW_PLAIN_DB instance as QUESTIONDB below — the Prisma
# tables (lowercase, e.g. `users`) and QuestionBank* tables (PascalCase)
# don't collide, verified directly against the live DB before switching.
DATABASE_URL=postgres://postgres:<password>@187.77.187.96:9876/postgres

NEXTAUTH_URL=https://your-deployed-domain.example
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Question bank DB — read via the raw `pg` (Postgres) client in
# src/app/api/chapter/route.ts and src/app/api/questions/route.ts, so this
# MUST be a Postgres connection string. Use the NEW_PLAIN_DB Postgres
# instance (the migrated question bank) — NOT the old 144.24.123.54 DB
# (deleted/unreachable) and NOT the Hostinger MariaDB copy (wrong dialect
# for `pg`).
QUESTIONDB=postgres://postgres:<password>@187.77.187.96:9876/postgres

AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2

NODE_ENV=production
PORT=3000
